@page "/Login"
@rendermode InteractiveServer
@inject IHashingService Hashing
@inject IUserService UserService
@using Clubies.Models
@using Clubies.Services.Interfaces
@using Microsoft.AspNetCore.Components


<h3>Login</h3>

<div class="registration-form">
    <form action="/login" method="post">
        <AntiforgeryToken/>

        @if(LoginFailed)
        {
            <p class="text-danger">Invalid username or password</p>
        }

        <div class="registration-field">
            <label for="Username">Username</label>
            <input id="Username" name="username" placeholder="PepMaster007" autocomplete="off"/>
        </div>

        <div class="registration-field">
            <label for="Password">Password</label>
            <input id="Password" name="password" placeholder="Password123!" autocomplete="off" type="password" />
        </div>

        <div class="registration-field">
            <input type="submit" value="Login" />
        </div>
    </form>


